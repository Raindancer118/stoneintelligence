{
  "name": "stoneintelligence-plugin",
  "version": "0.15.1",
  "description": "Obsidian-Plugin fuer StoneIntelligence: Live-Sync, Cursor-Presence, Note-Level-UI.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs --production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
